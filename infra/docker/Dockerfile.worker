# ─────────────────────────────────────────────────────────────────
# Dockerfile.worker — BullMQ Unified Pipeline Worker
# Consolidated high-performance worker image for all pipeline stages
# ─────────────────────────────────────────────────────────────────

FROM node:22-alpine AS builder
RUN npm install -g pnpm@9.15.4
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY workers/package.json ./workers/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install

COPY packages/shared ./packages/shared
COPY workers ./workers
COPY apps/api/prisma ./apps/api/prisma
COPY tsconfig.json ./

# Build shared package first
RUN pnpm --filter shared build

# Generate Prisma Client
RUN cd apps/api && npx prisma generate

# Build workers
RUN pnpm --filter workers build

FROM node:22-alpine AS runner
# Install ffmpeg for video workers
RUN apk add --no-cache ffmpeg curl python3

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/workers/dist ./dist
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# Execute unified worker by default
CMD ["node", "dist/unified.js"]
