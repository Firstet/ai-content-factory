# AI Content Factory — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ==========================================
# CORE APPLICATION
# ==========================================
NODE_ENV=production
APP_URL=http://localhost

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://acf_user:acf_password@postgres:5432/acf_db
POSTGRES_USER=acf_user
POSTGRES_PASSWORD=acf_password
POSTGRES_DB=acf_db

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=change_me_to_a_64_char_random_string_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_64_char_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# ENCRYPTION (for API keys stored in DB)
# ==========================================
ENCRYPTION_SECRET=change_me_to_a_32_char_hex_string_for_aes256

# ==========================================
# SUPER ADMIN (seed account)
# ==========================================
SUPER_ADMIN_EMAIL=admin@aicontentfactory.local
SUPER_ADMIN_PASSWORD=ChangeMe!2024

# ==========================================
# MINIO (S3-Compatible Storage)
# ==========================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=acf_minio_access
MINIO_SECRET_KEY=acf_minio_secret
MINIO_BUCKET=acf-assets

# ==========================================
# API (NestJS)
# ==========================================
API_PORT=3001
API_PREFIX=api

# ==========================================
# WEB (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/api

# ==========================================
# AI PROVIDER KEYS
# (These are stored encrypted in the DB via the Admin panel.
#  The keys below are optional bootstrap keys for initial setup.)
# ==========================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_API_KEY=nvapi-...
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================
# SOCIAL MEDIA OAUTH
# ==========================================
# YOUTUBE_CLIENT_ID=...
# YOUTUBE_CLIENT_SECRET=...
# YOUTUBE_REDIRECT_URI=http://localhost/api/channels/youtube/callback

# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...

# INSTAGRAM_APP_ID=...
# INSTAGRAM_APP_SECRET=...

# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...

# TWITTER_API_KEY=...
# TWITTER_API_SECRET=...

# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...

# ==========================================
# FFMPEG (path inside Docker)
# ==========================================
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ==========================================
# REMOTION
# ==========================================
REMOTION_CONCURRENCY=2

# ==========================================
# RATE LIMITING
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
