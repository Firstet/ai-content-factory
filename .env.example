# ==================================================
# AI Content Factory — Production Environment Variables Example
# Copy this file to .env and fill in your values.
# ==================================================

# Core Application
NODE_ENV=production
APP_URL=https://youtub-auto-5opxww-7caa24-169-58-142-29.sslip.io

# Database (PostgreSQL container service)
DATABASE_URL=postgresql://acf_user:acf_password@postgres:5432/acf_db
POSTGRES_USER=acf_user
POSTGRES_PASSWORD=acf_password
POSTGRES_DB=acf_db

# Redis (Redis container service)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptographic Authentication Secrets
JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
REFRESH_TOKEN_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (for API keys stored in DB)
ENCRYPTION_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Super Admin Account
SUPER_ADMIN_EMAIL=admin@aicontentfactory.local
SUPER_ADMIN_PASSWORD=ChangeMe!2024

# MinIO (S3 Object Storage container service)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=acf_minio_access
MINIO_SECRET_KEY=acf_minio_secret_key_12345
MINIO_BUCKET=acf-assets

# NestJS Backend API
API_PORT=3001
API_PREFIX=api
INTERNAL_API_URL=http://api:3001/api

# Next.js Web Frontend Studio (Client Side Public Endpoints)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/api/events

# ==================================================
# AI PROVIDERS (Configurable via Studio UI / Settings)
# ==================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==================================================
# SOCIAL MEDIA OAUTH & PUBLISHING CREDENTIALS
# ==================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://youtub-auto-5opxww-7caa24-169-58-142-29.sslip.io/api/channels/oauth/youtube/callback
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

LINKEDIN_CLIENT_ID=
