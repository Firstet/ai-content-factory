# ==================================================
# AI Content Factory — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==================================================

# Core Application
NODE_ENV=production
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://acf_user:acf_password@postgres:5432/acf_db
POSTGRES_USER=acf_user
POSTGRES_PASSWORD=acf_password
POSTGRES_DB=acf_db

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication
JWT_SECRET=change_me_to_a_64_char_random_string_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_64_char_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# AES-256-GCM Encryption (for API keys stored in DB)
ENCRYPTION_SECRET=change_me_to_a_32_char_hex_string_for_aes256

# Super Admin Account
SUPER_ADMIN_EMAIL=admin@aicontentfactory.local
SUPER_ADMIN_PASSWORD=ChangeMe!2024

# MinIO (S3 Object Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=acf_minio_access
MINIO_SECRET_KEY=acf_minio_secret
MINIO_BUCKET=acf-assets

# NestJS API
API_PORT=3001
API_PREFIX=api

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/api

# ==================================================
# AI PROVIDERS (Fallback keys if not added in Admin UI)
# ==================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==================================================
# SOCIAL MEDIA OAUTH & PUBLISHING CREDENTIALS
# ==================================================
# YouTube (Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost/api/channels/oauth/youtube/callback
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# TikTok (Content Posting API v2)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Facebook Graph API
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
